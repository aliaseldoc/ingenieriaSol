# Modulo de fichaje. En true aparecen las pantallas de fichaje, sus items de
# menu, las alertas del panel, la solapa de empleados de fabrica y el campo
# "N° en el reloj". Cualquier otro valor (o la variable sin definir) lo deja
# oculto, que es como esta en produccion mientras la norma no rija en la
# fabrica. No afecta la toma de fichajes: el reloj sigue registrando igual.
VITE_FICHAJE_HABILITADO=true
