{
  "rewrites": [
    {
      "source": "/iclock/:accion",
      "destination": "/api/iclock?accion=:accion"
    },
    {
      "source": "/iclock/:accion/:resto*",
      "destination": "/api/iclock?accion=:accion"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
